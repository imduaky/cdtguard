# Optional flags appended to `cdtguard run` by systemd.
# The default action is visible here so it can be changed without rebuilding.
# Configuration such as the limit, mode, and interface is normally saved by
# `cdtguard init` in /var/lib/cdtguard/state.bin.
#
# systemd splits this value on whitespace. Keep each argument as one word;
# for commands containing spaces, use `systemctl edit cdtguard` instead.
# Examples:
#   CDTGUARD_ARGS="-cmd poweroff -restore-cmd /usr/local/sbin/restore"
CDTGUARD_ARGS="-cmd shutdown"
